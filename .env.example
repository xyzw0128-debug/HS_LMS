# ==========================================
# 이 파일을 복사해서 ".env" 라는 이름으로 만든 뒤, 값을 채워주세요.
# (.env 는 절대 다른 사람에게 보내거나 GitHub에 올리지 마세요!)
# ==========================================
# [필수] 한신대학교 LMS 로그인 정보
# ==========================================
HS_USER_ID=아이디
HS_USER_PW=비밀번호

# ==========================================
# [필수] 디스코드 채널 웹훅 URL
# (채널 설정 -> 연동 -> 웹후크 -> 새 웹후크 -> URL 복사)
# ==========================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# ==========================================
# [선택] Gemini AI 공지 3줄 요약 API 키
# (미입력 시 자체 로컬 요약 엔진으로 자동 동작)
# 무료 발급: https://aistudio.google.com/app/apikey
# ==========================================
GEMINI_API_KEY=
